# Copy to .env next to compose.yaml (optional).
# Host docker.sock group GID — used by agent group_add when not running as root.
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Override agent user (default 0:0 in compose for socket access).
# HEIMDALL_AGENT_USER=65532:65532

# Do NOT set HEIMDALL_ENABLE_K8S=true here for the Compose sample agent —
# compose.yaml hardcodes HEIMDALL_ENABLE_K8S: "false" + command --enable-k8s false.
# (A truthy value in the shell/.env used to flip the agent back to k8s=true via ${…}.)
