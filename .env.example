# REQUIRED, no default. Generate: openssl rand -hex 32
HEIMDALL_BOOTSTRAP_TOKEN=
# REQUIRED for Compose/Postgres: encrypts secrets at rest. Generate: openssl rand -hex 32. BACK IT UP.
HEIMDALL_SECRET_KEY=
HEIMDALL_HUB_URL=http://127.0.0.1:43123
# REQUIRED, no default: signs session cookies (>= 32 chars). Generate: openssl rand -hex 32
HEIMDALL_SESSION_SECRET=
HEIMDALL_PUBLIC_URL=http://127.0.0.1:43123
# Preferred alias for alert deep links (falls back to HEIMDALL_PUBLIC_URL):
# HEIMDALL_PUBLIC_BASE_URL=http://127.0.0.1:43123
HEIMDALL_RP_ID=localhost
HEIMDALL_ORIGIN=http://127.0.0.1:43123
# Leave unset (or set HEIMDALL_DB_DRIVER=pglite) for in-process PGlite.
# REQUIRED for Compose Postgres (no default). New install: openssl rand -hex 24.
# Existing Compose volumes were initialised with "heimdall": set that, or rotate it first
# (docs/runbooks/postgres-password.md). Changing this value never changes an initialised DB.
POSTGRES_PASSWORD=
# Dev hub against the Compose Postgres (127.0.0.1 only), same password as above:
# DATABASE_URL=postgres://heimdall:<POSTGRES_PASSWORD>@127.0.0.1:54329/heimdall?sslmode=disable

# Request protection (see docs/deploy.md). Rate vars are max/windowSeconds.
# HEIMDALL_TRUST_PROXY=1        # only behind a reverse proxy you control
# HEIMDALL_RATE_LOGIN=10/900
# HEIMDALL_RATE_MFA=5/300
# HEIMDALL_RATE_INGEST=600/60
# HEIMDALL_MAX_BODY_INGEST=1048576
# Outbound SSRF guard allowlist (hosts, IPs, CIDRs) for LAN IdPs/webhooks/GitLab:
# HEIMDALL_ALLOW_PRIVATE_HOSTS=gitlab.lan,203.0.113.20/24
